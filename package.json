{
  "name": "filemanager-tp",
  "version": "1.0.0",
  "private": true,
  "description": "FileManager - Gestor Universal de Archivos, Escaner de Camara y Suite PDF (Ionic 9 + Angular Standalone + Capacitor 8)",
  "scripts": {
    "start": "node start-all.cjs",
    "ionic": "npm --prefix frontend run ionic",
    "api": "npm --prefix frontend run api",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test -- --watch=false",
    "sync:android": "npx --prefix frontend cap sync android"
  }
}
